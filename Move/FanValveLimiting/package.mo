within cdl_models.Move;
package FanValveLimiting
  extends Modelica.Icons.VariantsPackage;
  annotation (Documentation(info="<html>
<p>
This package contains control sequences that change the upper limits of the fan
speed or cooling coil valve position in one or more air handling units in order to
achieve demand flexibility.
</p>
</html>"));
end FanValveLimiting;
